# ─────────────────────────────────────────────────────────────────
# LearnFlow Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────────

# ── Google Gemini (REQUIRED - already configured) ─────────────────
# Get your key at: https://aistudio.google.com/apikey
# Free tier: 15 RPM, limited daily quota
GEMINI_API_KEY=AIza...

# ── Groq (HIGHLY RECOMMENDED - best free alternative) ─────────────
# Get your free key at: https://console.groq.com/
# Free tier: 14,400 requests/day, 6,000 tokens/min
# Models: Llama 3.3 70B, Llama 3.1 8B, Gemma2 9B, Mixtral 8x7B
GROQ_API_KEY=gsk_...

# ── OpenRouter (OPTIONAL - routes to many free models) ────────────
# Get your free key at: https://openrouter.ai/
# Free models: DeepSeek R1, Llama 3.3 70B, Mistral 7B, Qwen 72B
OPENROUTER_API_KEY=sk-or-...

# ── Django ────────────────────────────────────────────────────────
SECRET_KEY=your-django-secret-key
DEBUG=True
